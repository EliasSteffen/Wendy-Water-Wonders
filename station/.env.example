# Copy to ~/water-quality/.env on the Pi and fill in. Never commit .env.
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<your-hub>.azure-devices.net;DeviceId=wp07;SharedAccessKey=...
POINT_ID=wp07
# Turbidity voltage divider: 1.5 (10k + 20k) or 2.0 (10k + 10k). Check the breadboard.
TURBIDITY_DIVIDER_RATIO=2.0
# Set to 0 while the turbidity sensor isn't wired right: turbidity is then sent as null
TURBIDITY_ENABLED=1
# Turbidity sensor voltage in clear water: written by `uploader.py --calibrate-turbidity`
TURBIDITY_CLEAR_V=
# Status LEDs white, yellow, red as BCM GPIO numbers (see leds.py for wiring)
LED_PINS=17,27,22
TDS_K=1.0
WATER_TEMP_C=25
# pH calibration from `python ph_test.py --calibrate` (voltage in pH 7.0 / pH 4.0 buffer).
# Empty = not calibrated, pH is sent as null. Uncalibrated DFRobot defaults: 1.500 / 2.032
PH_V7=
PH_V4=
# Seconds between measurements. For the demo e.g. 5, then: sudo systemctl restart water-uploader
# IoT Hub S1 allows 400,000 messages/day, so even 1 s fits
INTERVAL_S=30
# Set to 1 if the network blocks MQTT port 8883 (uses port 443 instead)
IOTHUB_WEBSOCKETS=0
# Measurements per upload message, and buffer limit (200000 ≈ 70 days offline at 30 s, ~80 MB)
UPLOAD_BATCH=100
MAX_BUFFER_ROWS=200000
